# Required
OWNER_PRIVATE_KEY=0xYOUR_EXECUTOR_OWNER_PRIVATE_KEY
TX_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
WS_RPC_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional
# HTTP RPC used for quote scans.
QUOTE_RPC_URL=https://arbitrum.blockpi.network/v1/rpc/YOUR_BLOCKPI_KEY
# Optional fallback for quote scans; defaults to TX_RPC_URL when different from QUOTE_RPC_URL.
QUOTE_FALLBACK_RPC_URL=
EXECUTOR_CONTRACT_ADDRESS=0x860Ad26c581B533016aC62152De040649208508B
# Optional. Leave empty to auto-resolve the WETH/aWETH Uniswap V3 pools from POOL_FEES.
POOL_ADDRESS=
# Comma-separated fee tiers to scan and listen to. If unset, falls back to POOL_FEE.
POOL_FEES=100,500,3000
POOL_FEE=500
MAX_AWETH_SCAN_ETH=400
LOW_COARSE_MAX_ETH=5
LOW_COARSE_STEP_ETH=0.5
COARSE_STEP_ETH=5
FINE_STEP_ETH=0.1
FINE_WINDOW_ETH=3
# Multicall batches this many quote calls into one RPC request.
QUOTE_BATCH_SIZE=80
QUOTE_CONCURRENCY=6
LOCAL_QUOTE_ENABLED=false
# Timeout for hybrid local refinement before falling back to the QuoterV2 scan. Set 0 to disable.
LOCAL_QUOTE_TIMEOUT_MS=120000
# Extra local Uniswap V3 SDK quote comparison logs for the final quote.
LOCAL_QUOTE_SHADOW=false
# Keep every profitable fee tier by default. Raise this to cap weak profitable tiers at 1 wei.
SWAP_POOL_MIN_AWETH_RATIO_BPS=0
# Pool/executor events within this window are merged into one evaluation.
EVENT_DEBOUNCE_MS=2000
# Set 0 to disable periodic fallback and only re-evaluate on startup/events.
MONITOR_INTERVAL_MS=600000
UPDATE_DEVIATION_BPS=500
DRY_RUN=false

# Optional Bark push
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=
BARK_TITLE=aWETH Max Monitor
BARK_GROUP=AAVE_ARB
