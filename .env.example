# Required
OWNER_PRIVATE_KEY=0xYOUR_EXECUTOR_OWNER_PRIVATE_KEY
TX_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
WS_RPC_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional
# Defaults to the Arbitrum public RPC so quote traffic does not hit TX_RPC_URL.
QUOTE_RPC_URL=https://arb1.arbitrum.io/rpc
EXECUTOR_CONTRACT_ADDRESS=0x860Ad26c581B533016aC62152De040649208508B
# Optional. Leave empty to auto-resolve the WETH/aWETH Uniswap V3 pool from POOL_FEE.
POOL_ADDRESS=
POOL_FEE=500
MAX_AWETH_SCAN_ETH=400
COARSE_STEP_ETH=5
FINE_STEP_ETH=0.5
FINE_WINDOW_ETH=10
# Multicall batches this many quote calls into one RPC request.
QUOTE_BATCH_SIZE=20
QUOTE_CONCURRENCY=6
# Pool/executor events within this window are merged into one evaluation.
EVENT_DEBOUNCE_MS=2000
# Set 0 to disable periodic fallback and only re-evaluate on startup/events.
MONITOR_INTERVAL_MS=600000
UPDATE_DEVIATION_BPS=2000
DRY_RUN=false

# Optional Bark push
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=
BARK_TITLE=aWETH Max Monitor
BARK_GROUP=AAVE_ARB
